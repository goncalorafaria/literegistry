FROM python:3.12-slim-bookworm

ARG PIP_INDEX_URL
ARG PIP_FIND_LINKS
ARG PIP_TRUSTED_HOST
ARG LITEREGISTRY_VERSION=1.0.47

ENV VIRTUAL_ENV=/opt/literegistry-warmup-venv \
    PATH=/opt/literegistry-warmup-venv/bin:$PATH \
    PYTHONUNBUFFERED=1

RUN python -m venv "$VIRTUAL_ENV" \
    && pip install --no-cache-dir --upgrade pip setuptools wheel \
    && useradd --create-home --uid 10001 warmer

COPY . /opt/literegistry-podman-beaker
RUN pip install --no-cache-dir "literegistry==${LITEREGISTRY_VERSION}" \
    && pip install --no-cache-dir --no-deps /opt/literegistry-podman-beaker \
    && rm -rf /opt/literegistry-podman-beaker

USER warmer

ENTRYPOINT ["literegistry-podman-warm-podman"]
