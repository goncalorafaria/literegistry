FROM python:3.12-slim-bookworm

ARG PIP_INDEX_URL
ARG PIP_FIND_LINKS
ARG PIP_TRUSTED_HOST
ARG LITEREGISTRY_VERSION=1.0.49
ARG PODMAN_BEAKER_VERSION=0.2.16

ENV VIRTUAL_ENV=/opt/literegistry-warmup-venv \
    PATH=/opt/literegistry-warmup-venv/bin:$PATH \
    PYTHONUNBUFFERED=1

RUN python -m venv "$VIRTUAL_ENV" \
    && pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir \
        "literegistry==${LITEREGISTRY_VERSION}" \
        "literegistry-podman-beaker==${PODMAN_BEAKER_VERSION}" \
    && command -v literegistry-podman-warm-podman \
    && useradd --create-home --uid 10001 warmer

COPY --chown=warmer:warmer \
    src/literegistry_podman_beaker/assets/allenai-tmax-15k-open-instruct-images.txt \
    /opt/images.txt

USER warmer

ENTRYPOINT ["literegistry-podman-warm-podman"]
CMD ["--images_file=/opt/images.txt"]
