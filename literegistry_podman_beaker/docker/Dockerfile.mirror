FROM registry:3 AS distribution

FROM python:3.12-slim-bookworm

ARG PIP_INDEX_URL
ARG PIP_FIND_LINKS
ARG PIP_TRUSTED_HOST

ENV VIRTUAL_ENV=/opt/literegistry-mirror-venv \
    PATH=/opt/literegistry-mirror-venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/cache/huggingface \
    OTEL_TRACES_EXPORTER=none \
    DOCKER_MIRROR_HOST=0.0.0.0 \
    DOCKER_MIRROR_PORT=5000 \
    DOCKER_MIRROR_ADVERTISE_PORT=5000 \
    DOCKER_MIRROR_STORAGE_ROOT=/var/lib/registry \
    DOCKER_MIRROR_WARM_IMAGES_FILE=/opt/mirror-assets/allenai-tmax-15k-open-instruct-images.txt \
    DOCKER_MIRROR_WARM_WORKERS=8 \
    DOCKER_MIRROR_WARM_PLATFORM=linux/amd64 \
    DISTRIBUTION_CONFIG=/run/literegistry/config.yml

COPY --from=distribution /bin/registry /usr/local/bin/registry

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python -m venv "$VIRTUAL_ENV" \
    && pip install --no-cache-dir --upgrade pip setuptools wheel \
    && useradd --create-home --uid 10001 mirror \
    && install -d -o mirror -g mirror \
        /cache/huggingface \
        /opt/mirror-assets \
        /run/literegistry \
        /var/lib/registry

COPY . /opt/literegistry-podman-beaker
RUN pip install --no-cache-dir \
        /opt/literegistry-podman-beaker \
        'huggingface-hub>=0.27,<2' \
    && rm -rf /opt/literegistry-podman-beaker

COPY --chown=mirror:mirror src/literegistry_podman_beaker/assets/ /opt/mirror-assets/

USER mirror
VOLUME ["/var/lib/registry", "/cache/huggingface"]
EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/v2/', timeout=5).read()"

ENTRYPOINT ["python", "-m", "literegistry.services.docker_mirror_server"]
CMD ["--allow_non_loopback=True"]
